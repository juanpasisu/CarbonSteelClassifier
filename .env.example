# Backend application
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_PATH=ml/models/trained/active.keras
# Docker/Render: HTTPS URL used to download active.keras when the file is missing.
MODEL_URL=
# Docker/Render single-service: path to Vite dist (leave empty for local API-only).
FRONTEND_DIST=

# Supabase (catalog, model metadata, anonymous stats). No Auth for end users.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Backend only: never expose this value through frontend variables or source code.
SUPABASE_SERVICE_ROLE_KEY=

ENABLE_PREDICTION_LOGGING=true

# Frontend (Vite loads this file via envDir=..). Empty string = same-origin API.
VITE_API_BASE_URL=http://127.0.0.1:8000
